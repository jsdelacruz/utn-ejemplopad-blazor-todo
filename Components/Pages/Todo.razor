@page "/todo"
@rendermode InteractiveServer  

<PageTitle>Todo List</PageTitle>

Todo: <input type="text" @bind="todoText" placeholder="Ingrese una tarea" />

<button class="btn btn-primary" @onclick="agregarTodo">Agregar</button>

<br /><br />
@foreach(var todo in todos){
    <div>
        <input type="checkbox" @bind="todo.listo" />
        <input type="text" @bind="@todo.tarea" />
        <button class="btn btn-danger" @onclick="@(()=>todos.Remove(todo))">Eliminar</button>
        
    </div><br />
}

Tareas completadas @todos.Count(p=>p.listo) 




@code{
    private List<Tarea> todos = new List<Tarea>();

    private string todoText = "";
    

    private void agregarTodo(){
        todos.Add(new Tarea{tarea = todoText, listo = false});        
    }

    private class Tarea{
        public string? tarea{get;set;}
        public bool listo{get;set;}
    }
}